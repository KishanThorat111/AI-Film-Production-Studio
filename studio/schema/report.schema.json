{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "studio/report/2",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "task_id",
  "lease_token",
  "verdict",
  "coverage",
  "observations",
  "findings",
  "limitations",
  "examined"
 ],
 "properties": {
  "schema_version": {
   "const": "2"
  },
  "task_id": {
   "type": "string"
  },
  "lease_token": {
   "type": "string"
  },
  "verdict": {
   "enum": [
    "APPROVED",
    "REJECTED",
    "NEEDS_CORRECTION",
    "NEEDS_INSPECTION",
    "UNCERTAIN",
    "NOT_APPLICABLE"
   ]
  },
  "coverage": {
   "description": "One row per acceptance criterion in the packet. The server rejects the report if a criterion is missing.",
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "criterion_id",
     "result",
     "evidence_ids"
    ],
    "properties": {
     "criterion_id": {
      "type": "string"
     },
     "result": {
      "enum": [
       "met",
       "not_met",
       "cannot_determine",
       "not_applicable"
      ]
     },
     "evidence_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "note": {
      "type": "string",
      "maxLength": 400
     }
    },
    "if": {
     "properties": {
      "result": {
       "enum": [
        "met",
        "not_met"
       ]
      }
     }
    },
    "then": {
     "properties": {
      "evidence_ids": {
       "minItems": 1
      }
     }
    }
   }
  },
  "observations": {
   "description": "What was seen, recorded before it is judged.",
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "text",
     "evidence_id"
    ],
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 500
     },
     "evidence_id": {
      "type": "string"
     }
    }
   }
  },
  "findings": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "defect_class",
     "severity",
     "statement",
     "reason",
     "evidence_id",
     "next_action"
    ],
    "properties": {
     "defect_class": {
      "type": "string"
     },
     "severity": {
      "enum": [
       "critical",
       "major",
       "moderate",
       "minor",
       "info"
      ]
     },
     "statement": {
      "type": "string",
      "maxLength": 600
     },
     "evidence_id": {
      "type": "string"
     },
     "frames": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
     },
     "region": {
      "type": "array",
      "items": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
     },
     "requirement_ref": {
      "type": "string"
     },
     "suggested_fix": {
      "type": "string",
      "maxLength": 400
     },
     "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
     },
     "next_action": {
      "enum": [
       "none",
       "re_inspect",
       "correct_image",
       "recover_edit",
       "recover_composite",
       "redesign_shot",
       "regenerate",
       "ask_user"
      ]
     }
    }
   }
  },
  "limitations": {
   "description": "What could not be inspected. An empty array is a positive claim.",
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "escalation": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "question",
    "options"
   ],
   "properties": {
    "question": {
     "type": "string"
    },
    "options": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 2
    }
   }
  },
  "lessons_used": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "examined": {
   "description": "What was really examined. A report may not claim motion or sound it did not receive; the server checks this against served evidence.",
   "type": "array",
   "minItems": 1,
   "items": {
    "enum": [
     "still_frames",
     "contact_sheet",
     "slit_scan",
     "frame_strip",
     "measurements",
     "transcript",
     "audio_waveform",
     "full_video",
     "audio",
     "document_text"
    ]
   }
  }
 }
}